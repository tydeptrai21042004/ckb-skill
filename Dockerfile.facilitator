FROM node:24.20.0-alpine3.24
WORKDIR /app
COPY package.json ./package.json
COPY packages/x402-fiber ./packages/x402-fiber
COPY packages/http-security ./packages/http-security
COPY packages/production-store ./packages/production-store
COPY apps/fiber-facilitator ./apps/fiber-facilitator
RUN npm install --omit=dev --workspace @skillpass/fiber-facilitator --include-workspace-root=false --no-audit --no-fund \
 && mkdir -p /state && chown -R node:node /app /state
USER node
ENV FACILITATOR_HOST=0.0.0.0
ENV FACILITATOR_PORT=8790
ENV FACILITATOR_STATE_FILE=/state/fiber-settled.json
EXPOSE 8790
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:8790/livez').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "apps/fiber-facilitator/server.mjs"]
