FROM node:22-alpine
WORKDIR /app
COPY packages/x402-fiber ./packages/x402-fiber
COPY apps/fiber-facilitator ./apps/fiber-facilitator
RUN mkdir -p /state && chown -R node:node /app /state
USER node
ENV FACILITATOR_HOST=0.0.0.0
ENV FACILITATOR_PORT=8790
ENV FACILITATOR_STATE_FILE=/state/fiber-settled.json
EXPOSE 8790
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:8790/readyz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "apps/fiber-facilitator/server.mjs"]
