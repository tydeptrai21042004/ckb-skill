FROM node:24.20.0-alpine3.24 AS web
WORKDIR /repo
COPY package.json ./package.json
COPY packages/capability-codec ./packages/capability-codec
COPY packages/auth-protocol ./packages/auth-protocol
COPY packages/provider-verifier ./packages/provider-verifier
COPY packages/service-rights ./packages/service-rights
COPY packages/service-gateway ./packages/service-gateway
COPY packages/delegation ./packages/delegation
COPY packages/ckb-client ./packages/ckb-client
COPY apps/web ./apps/web
RUN npm install --workspace @skillpass/web --include-workspace-root=false --no-audit --no-fund \
 && npm run build --workspace @skillpass/web

FROM node:24.20.0-alpine3.24 AS runtime
WORKDIR /app
COPY package.json ./package.json
COPY packages/capability-codec ./packages/capability-codec
COPY packages/auth-protocol ./packages/auth-protocol
COPY packages/provider-verifier ./packages/provider-verifier
COPY packages/service-rights ./packages/service-rights
COPY packages/service-gateway ./packages/service-gateway
COPY packages/delegation ./packages/delegation
COPY packages/x402-fiber ./packages/x402-fiber
COPY packages/http-security ./packages/http-security
COPY packages/production-store ./packages/production-store
COPY apps/live-service ./apps/live-service
COPY --from=web /repo/apps/web/dist ./apps/live-service/public
RUN npm install --omit=dev --workspace @skillpass/live-service --include-workspace-root=false --no-audit --no-fund \
 && chown -R node:node /app
USER node
ENV HOST=0.0.0.0
ENV PORT=8787
EXPOSE 8787
HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:8787/livez').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "apps/live-service/server.mjs"]
