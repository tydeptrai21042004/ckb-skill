FROM node:22-alpine AS web
WORKDIR /repo
COPY packages/capability-codec ./packages/capability-codec
COPY packages/ckb-client ./packages/ckb-client
COPY apps/web ./apps/web
RUN npm install --prefix packages/ckb-client
RUN npm install --prefix apps/web
RUN npm run build --prefix apps/web

FROM node:22-alpine AS runtime
WORKDIR /app
COPY packages/capability-codec ./packages/capability-codec
COPY apps/live-service ./apps/live-service
COPY apps/demo-service/src/paper-analyzer.mjs ./apps/demo-service/src/paper-analyzer.mjs
COPY --from=web /repo/apps/web/dist ./apps/live-service/public
RUN npm install --omit=dev --prefix apps/live-service
ENV HOST=0.0.0.0
ENV PORT=8787
EXPOSE 8787
HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8787/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "apps/live-service/server.mjs"]
