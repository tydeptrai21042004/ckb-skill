{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "vite"
    },

    "api": {
      "root": "apps/live-service/",
      "entrypoint": "server.ts",
      "bindings": [
        {
          "type": "service",
          "service": "facilitator",
          "format": "url",
          "env": "FACILITATOR_URL"
        }
      ]
    },

    "facilitator": {
      "root": "apps/fiber-facilitator/",
      "entrypoint": "server.ts"
    }
  },

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/.well-known/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/readyz",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/livez",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
