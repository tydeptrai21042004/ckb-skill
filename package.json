{
  "name": "ckb-skillpass",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "setup": "node scripts/dev-cli.mjs setup",
    "help": "node scripts/dev-cli.mjs help",
    "doctor": "node scripts/dev-cli.mjs doctor",
    "dev": "node scripts/dev-cli.mjs demo",
    "dev:demo": "node scripts/dev-cli.mjs demo",
    "dev:web": "node scripts/dev-cli.mjs web",
    "dev:frontend-only": "npm run dev --prefix apps/web",
    "dev:facilitator": "node scripts/dev-cli.mjs facilitator",
    "dev:live": "node scripts/dev-cli.mjs live",
    "check": "node scripts/dev-cli.mjs check",
    "clean": "node scripts/dev-cli.mjs clean",
    "docker:demo": "node scripts/dev-cli.mjs docker-demo",
    "bootstrap": "node scripts/bootstrap.mjs",
    "serve": "node apps/demo-service/server.mjs",
    "test": "node --test",
    "smoke:http": "node scripts/smoke-http.mjs",
    "demo": "node scripts/demo-flow.mjs",
    "verify": "node scripts/verify.mjs && npm run smoke:fiber && npm run smoke:paid && npm run benchmark",
    "verify:contract": "make -C contracts/capability-type test",
    "verify:full": "bash scripts/verify-full.sh",
    "setup:live": "npm install --prefix packages/ckb-client",
    "typecheck:ckb": "npm run typecheck --prefix packages/ckb-client",
    "release": "node scripts/release.mjs",
    "verify:contract:docker": "node scripts/contract-docker.mjs",
    "bootstrap:live": "node scripts/bootstrap-live.mjs",
    "doctor:live": "node scripts/doctor-live.mjs",
    "smoke:fiber": "node scripts/smoke-facilitator.mjs",
    "facilitator": "node apps/fiber-facilitator/server.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "build:web": "npm run build --prefix apps/web",
    "smoke:paid": "node scripts/smoke-paid-http.mjs",
    "deploy:demo": "bash deploy.sh demo",
    "deploy:init": "bash deploy.sh init-testnet",
    "deploy:doctor": "bash deploy.sh doctor",
    "deploy:testnet": "bash deploy.sh testnet",
    "verify:deploy": "bash -n deploy.sh && node --check apps/live-service/server.mjs && node --check apps/live-service/discovery.mjs && node --check scripts/dev-product.mjs && node --check apps/fiber-facilitator/server.mjs && node --check packages/x402-fiber/src/http-client.mjs",
    "support": "node scripts/support-bundle.mjs",
    "deploy:help": "node -e \"console.log(process.platform === 'win32' ? 'Run: deploy.cmd help' : 'Run: ./deploy.sh help')\"",
    "test:security": "node --test packages/http-security/test/security.test.mjs tests/security-xss.test.mjs tests/security-readiness-v1.4.test.mjs",
    "smoke:security-browser": "node scripts/browser-security-smoke.mjs",
    "verify:security": "npm run test:security && npm run smoke:security-browser",
    "deploy:production:init": "bash deploy-production.sh init",
    "deploy:production:doctor": "bash deploy-production.sh doctor",
    "deploy:production": "bash deploy-production.sh up",
    "deploy:production:smoke": "bash deploy-production.sh smoke",
    "deploy:production:scale": "bash deploy-production.sh scale",
    "deploy:production:health": "bash deploy-production.sh health",
    "deploy:production:backup": "bash deploy-production.sh backup",
    "verify:production": "bash -n deploy-production.sh && node --check apps/live-service/server.mjs && node --check apps/live-service/runtime-state.mjs && node --check apps/fiber-facilitator/server.mjs && node --test tests/production-deployment.test.mjs tests/production-store.test.mjs",
    "vercel:check": "node scripts/check-vercel-env.mjs",
    "setup:vercel": "bash setup-vercel.sh",
    "setup:vercel:contract": "SKILLPASS_SKIP_VERCEL=1 bash setup-vercel.sh",
    "vercel:extract": "node scripts/extract-offckb-deployment.mjs",
    "setup:vercel:firewall": "bash setup-vercel-firewall.sh",
    "security:preflight": "node scripts/security-preflight.mjs",
    "verify:vercel:secure": "bash -n setup-vercel.sh && bash -n setup-vercel-firewall.sh && node scripts/security-preflight.mjs && node --test tests/vercel-config.test.mjs tests/vercel-easy-deploy.test.mjs tests/vercel-security-hardening.test.mjs packages/http-security/test/security.test.mjs",
    "vercel:env:gui": "bash collect-vercel-env.sh",
    "typecheck:vercel": "tsc -p apps/live-service/tsconfig.json && tsc -p apps/fiber-facilitator/tsconfig.json",
    "verify:workspaces": "node scripts/check-workspace-deps.mjs",
    "provider:admin": "node scripts/provider-admin.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
